# Copy to .env and fill in. Never commit .env.

# --- Runtime ---
TZ=Asia/Amman
APP_ENV=dev                        # dev | prod
LOG_LEVEL=info
LOG_FILE=                          # optional; when set, logs also go here (rotated by deploy/logrotate/bot)

# --- Database (PostgreSQL + pgvector) ---
DATABASE_URL=postgresql+psycopg://bot:bot@localhost:5432/bot
EMBED_DIM=768                       # embedding dimension for the item_embeddings vector column

# --- Telegram (primary channel) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=          # comma-separated user ids; empty = allow everyone
TELEGRAM_WEBHOOK_URL=               # public https URL, e.g. https://bot.example.com/telegram/webhook
TELEGRAM_WEBHOOK_SECRET=            # random string; sent back in X-Telegram-Bot-Api-Secret-Token and verified
TELEGRAM_DEFAULT_CHAT_ID=          # chat id that scheduled briefings are delivered to

# --- Email (read + filter my mailbox; also a delivery target) ---
EMAIL_IMAP_HOST=
EMAIL_IMAP_PORT=993
EMAIL_IMAP_SSL=true
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_ADDRESS=
EMAIL_PASSWORD=                     # app password, or use OAuth for Gmail
EMAIL_BRIEF_TO=                     # where email-delivered briefings are sent

# --- Instagram (optional, later) ---
IG_USERNAME=
IG_PASSWORD=

# --- LLM provider chain (hosted free tiers first, Ollama last) ---
# Order is defined in config/schedule.yaml -> llm.chain; keys live here.
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
CEREBRAS_API_KEY=

# Local fallback (only used when every hosted provider is rate-limited)
OLLAMA_HOST=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.1:8b
OLLAMA_EMBED_MODEL=nomic-embed-text

# --- Data connectors ---
WEATHER_API_KEY=
FINANCE_API_KEY=

# --- Scraping ---
PLAYWRIGHT_HEADLESS=true
SCRAPE_TIMEOUT_MS=15000
SCRAPE_PER_SITE_DELAY=1.0
SCRAPE_CACHE_TTL_MIN=60
SEMANTIC_DEDUP_THRESHOLD=0.08       # cosine distance at/below which a scraped item is a duplicate
