# Copy to .env and fill in. Never commit .env.

# --- Active channel: whatsapp | instagram | email ---
BOT_CHANNEL=email

# --- LLM ---
LLM_PROVIDER=ollama            # ollama | anthropic | openai
LLM_MODEL=llama3.1
OLLAMA_HOST=http://localhost:11434
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- WhatsApp (Cloud API) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# --- Instagram (Graph API) ---
IG_ACCESS_TOKEN=
IG_ACCOUNT_ID=

# --- Email (IMAP/SMTP) ---
EMAIL_IMAP_HOST=
EMAIL_SMTP_HOST=
EMAIL_ADDRESS=
EMAIL_PASSWORD=
EMAIL_TO=                       # where briefings are sent

# --- Data connectors ---
NEWS_API_KEY=
WEATHER_API_KEY=
FINANCE_API_KEY=

# --- Runtime ---
TZ=Asia/Amman
LOG_LEVEL=info
